#!/usr/bin/env bash
# Slow security collector for the Omarchy security widget.
#
# Split from omarchy-security-collect because everything here is expensive:
# arch-audit makes a network call to security.archlinux.org, and a full
# pacman -Qkk checksums every packaged file on the system. Neither belongs
# on a 60-second loop. Runs hourly; the file-integrity sweep is additionally
# throttled to once a day and its last result cached in between.

set -uo pipefail

if [ "$(id -u)" -eq 0 ]; then
  PRIVILEGED=1
  DEFAULT_RUNTIME=/run/omarchy-security
  DEFAULT_STATE=/var/lib/omarchy-security
else
  PRIVILEGED=0
  DEFAULT_RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/omarchy-security"
  DEFAULT_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-security"
fi

OUT_DIR="${OMARCHY_SECURITY_RUNTIME:-$DEFAULT_RUNTIME}"
STATE_DIR="${OMARCHY_SECURITY_STATE:-$DEFAULT_STATE}"
OUT="$OUT_DIR/integrity.json"
AUDIT_STATE="$STATE_DIR/audit-state.json"
FILECHECK_INTERVAL=${OMARCHY_SECURITY_FILECHECK_INTERVAL:-86400}

mkdir -p "$OUT_DIR" "$STATE_DIR" 2>/dev/null
[ -f "$AUDIT_STATE" ] || echo '{}' > "$AUDIT_STATE"

rank_of() {
  case "$1" in
    fail) echo 3 ;; warn) echo 2 ;; unknown) echo 1 ;; *) echo 0 ;;
  esac
}

CHECKS_JSON=""
add_check() {
  local obj
  obj=$(jq -nc --arg id "$1" --arg label "$2" --arg status "$3" \
    --arg detail "$4" --arg remedy "${5:-}" \
    '{id:$id,label:$label,status:$status,detail:$detail,remedy:$remedy}')
  CHECKS_JSON="${CHECKS_JSON}${obj}"$'\n'
}

have() { command -v "$1" >/dev/null 2>&1; }

state_get() { jq -r --arg k "$1" '.[$k] // empty' "$AUDIT_STATE" 2>/dev/null; }
state_set() {
  jq -c --arg k "$1" --argjson v "$2" '.[$k]=$v' "$AUDIT_STATE" > "$AUDIT_STATE.tmp" 2>/dev/null \
    && mv "$AUDIT_STATE.tmp" "$AUDIT_STATE"
}

NOW=$(date +%s)

# ------------------------------------------------- known vulnerabilities

CVE_TOTAL=0
ADVISORY_URL=${OMARCHY_SECURITY_ADVISORY_URL:-https://security.archlinux.org/issues/all.json}
ADVISORY_CACHE="$STATE_DIR/advisories.json"
ADVISORY_TTL=${OMARCHY_SECURITY_ADVISORY_TTL:-21600}   # 6h

check_cve() {
  if have arch-audit; then
    check_cve_arch_audit && return
  fi
  # arch-audit is the reference implementation, but it is a package, and the
  # widget is meant to be useful with nothing installed. The same advisory
  # data is a public JSON document, and pacman ships the version comparator
  # needed to use it, so fall back to doing the join ourselves.
  check_cve_builtin
}

check_cve_arch_audit() {
  local raw crit high med low names fixable
  raw=$(arch-audit --json 2>/dev/null)
  jq -e 'type=="array"' <<<"${raw:-}" >/dev/null 2>&1 || return 1

  # arch-audit emits one entry per advisory group, and several can name the
  # same package. Count and name packages, matching the fallback path, so the
  # two implementations report the same number for the same machine.
  CVE_TOTAL=$(jq '[.[] | .packages[]?] | unique | length' <<<"$raw")
  names=$(jq -r '[.[] | .packages[]?] | unique | join(" ")' <<<"$raw")
  fixable=$(jq '[.[] | select(.fixed != null) | .packages[]?] | unique | length' <<<"$raw")

  crit=$(jq '[.[] | select((.severity // "") | ascii_downcase == "critical") | .packages[]?] | unique | length' <<<"$raw")
  high=$(jq '[.[] | select((.severity // "") | ascii_downcase == "high") | .packages[]?] | unique | length' <<<"$raw")
  med=$(jq  '[.[] | select((.severity // "") | ascii_downcase == "medium") | .packages[]?] | unique | length' <<<"$raw")
  low=$(jq  '[.[] | select((.severity // "") | ascii_downcase | IN("low","unknown","")) | .packages[]?] | unique | length' <<<"$raw")

  emit_cve "$CVE_TOTAL" "${fixable:-0}" "${crit:-0}" "${high:-0}" "${med:-0}" "${low:-0}" \
    "$(tr ' ' ',' <<<"$names" | sed 's/,/, /g')" "arch-audit"
  return 0
}

# Refreshes the cached advisory document, tolerating being offline.
fetch_advisories() {
  local age=999999
  if [ -f "$ADVISORY_CACHE" ]; then
    age=$(( NOW - $(stat -c %Y "$ADVISORY_CACHE" 2>/dev/null || echo 0) ))
    [ "$age" -lt "$ADVISORY_TTL" ] && return 0
  fi
  have curl || return 1

  local tmp
  tmp=$(mktemp "$STATE_DIR/.adv.XXXXXX") || return 1
  if curl -fsS --max-time 25 -o "$tmp" "$ADVISORY_URL" 2>/dev/null \
     && jq -e 'type=="array" and length > 0' "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$ADVISORY_CACHE"
    return 0
  fi
  rm -f "$tmp"
  # A stale cache still beats no answer; the caller reports its age.
  [ -f "$ADVISORY_CACHE" ] && return 0
  return 1
}

check_cve_builtin() {
  if ! fetch_advisories; then
    add_check "int.cve" "Known vulnerabilities" "unknown" \
      "the advisory database is unreachable and nothing is cached" \
      "check connectivity, or install arch-audit"
    return
  fi

  local cache_age installed candidates
  cache_age=$(( NOW - $(stat -c %Y "$ADVISORY_CACHE" 2>/dev/null || echo "$NOW") ))

  installed=$(mktemp "$STATE_DIR/.inst.XXXXXX")
  pacman -Q 2>/dev/null | jq -Rn '[inputs | split(" ") | {key:.[0], value:.[1]}] | from_entries' > "$installed"

  # One jq pass to the shortlist of advisories naming a package we have.
  # Both statuses matter: "Vulnerable" means no fix exists yet, "Fixed" means
  # one does and we may simply not have installed it.
  #
  # Fields are joined with a pipe rather than emitted as TSV because tab is
  # IFS whitespace, so `read` silently collapses an empty field and shifts
  # every column after it.
  candidates=$(jq -r --slurpfile inst "$installed" '
    [ .[]
      | select(.status == "Vulnerable" or .status == "Fixed")
      | . as $a | .packages[]
      | select($inst[0][.] != null)
      | [., $inst[0][.], $a.status, ($a.fixed // ""),
         ($a.severity // "Unknown"), $a.name] | join("|")
    ] | unique | .[]' "$ADVISORY_CACHE" 2>/dev/null)
  rm -f "$installed"

  local pkg ins status fixed severity avg
  local total=0 fixable=0 crit=0 high=0 med=0 low=0 names=""

  while IFS='|' read -r pkg ins status fixed severity avg; do
    [ -z "${pkg:-}" ] && continue

    # "Vulnerable" carries no fixed version because there is no fix — so
    # having the package at all is the finding, whatever version it is.
    # Deliberately NOT compared against the advisory's `affected` field:
    # that records the version the advisory was filed against, not a ceiling
    # below which you are safe.
    if [ "$status" = "Fixed" ]; then
      [ -n "$fixed" ] || continue
      [ "$(vercmp "$ins" "$fixed")" -lt 0 ] || continue
    fi

    # Count affected packages, not advisory rows: three CVEs against one
    # package is one thing to go and fix.
    case " $names " in *" $pkg "*) continue ;; esac

    [ "$status" = "Fixed" ] && fixable=$((fixable + 1))
    total=$((total + 1))
    case "$(tr '[:upper:]' '[:lower:]' <<<"$severity")" in
      critical) crit=$((crit + 1)) ;;
      high) high=$((high + 1)) ;;
      medium) med=$((med + 1)) ;;
      *) low=$((low + 1)) ;;
    esac
    case " $names " in *" $pkg "*) ;; *) names="${names:+$names }$pkg" ;; esac
  done <<<"$candidates"

  CVE_TOTAL=$total
  local source="security.archlinux.org"
  [ "$cache_age" -gt "$ADVISORY_TTL" ] && \
    source="security.archlinux.org, cached $(( cache_age / 3600 ))h ago"

  emit_cve "$total" "$fixable" "$crit" "$high" "$med" "$low" \
    "$(tr ' ' ',' <<<"$names" | sed 's/,/, /g')" "$source"
}

emit_cve() {
  local total="$1" fixable="$2" crit="$3" high="$4" med="$5" low="$6" names="$7" source="$8"
  local shown extra sev

  # Keep the sentence readable when fifteen packages are affected.
  shown=$(cut -d, -f1-6 <<<"$names")
  extra=$(( total - $(tr ',' '\n' <<<"$shown" | grep -c .) ))
  [ "$extra" -gt 0 ] && shown="$shown +$extra more"

  sev="$med medium, $low low"
  [ "$crit" -gt 0 ] || [ "$high" -gt 0 ] && sev="$crit critical, $high high"

  if [ "$total" -eq 0 ]; then
    add_check "int.cve" "Known vulnerabilities" "ok" \
      "no installed package has an open advisory ($source)"
  elif [ "$fixable" -gt 0 ]; then
    # A fix exists and is not installed. That is the actionable case, and the
    # only one worth turning the bar icon red for.
    add_check "int.cve" "Known vulnerabilities" "fail" \
      "$fixable of $total affected package(s) already have a fix you have not installed — $sev: $shown" \
      "omarchy update"
  else
    # Upstream has published no fix yet, so there is nothing to install. Worth
    # knowing, not worth an alarm you cannot act on.
    add_check "int.cve" "Known vulnerabilities" "warn" \
      "$total affected package(s), no fix released yet — $sev: $shown" \
      "nothing to do until Arch ships a fix; these clear themselves on update"
  fi
}

# ------------------------------------------------- packaged file integrity

check_files() {
  local last cached age
  last=$(state_get lastFileCheckUnix)
  cached=$(state_get fileResult)
  age=$(( NOW - ${last:-0} ))

  if [ -n "$last" ] && [ -n "$cached" ] && [ "$age" -lt "$FILECHECK_INTERVAL" ]; then
    report_files "$cached" "$age"
    return
  fi

  local out result
  out=$(pacman -Qkk 2>&1)
  if [ -z "$out" ]; then
    add_check "int.files" "Packaged file integrity" "unknown" "pacman -Qkk produced no output" ""
    return
  fi

  # pacman emits one line per differing attribute, so the same file appears
  # up to three times; classify per path, not per line, and let a content
  # difference outrank a mere timestamp one on the same file.
  #
  # Only executable paths are treated as a finding. A rewritten plymouth
  # asset under /usr/share is what a theming distro does to itself; a
  # rewritten binary under /usr/lib is not.
  result=$(awk '
    /^backup file:/ { next }
    !/^warning: /   { next }
    {
      line = $0
      sub(/^warning: /, "", line)
      pkg = line; sub(/:.*/, "", pkg)
      path = line; sub(/^[^:]*: /, "", path); sub(/ \(.*/, "", path)
      reason = line; sub(/^.*\(/, "", reason); sub(/\).*/, "", reason)

      if (reason ~ /failed to calculate|Permission denied|No such file/) cls = "unreadable"
      else if (reason ~ /SHA256|Size|File type/)                         cls = "content"
      else                                                               cls = "drift"

      r["unreadable"] = 1; r["drift"] = 2; r["content"] = 3
      if (!(path in klass) || r[cls] > r[klass[path]]) { klass[path] = cls; owner[path] = pkg }
    }
    END {
      for (path in klass) {
        cls = klass[path]
        if (cls == "unreadable") { unreadable++; continue }
        if (cls == "drift")      { drift++; continue }
        if (path == "/etc/resolv.conf") { drift++; continue }
        if (path ~ /^\/etc\//)  { conf++; continue }
        if (path ~ /^\/(usr\/)?(bin|sbin|lib|lib32|libexec)\//) { code++; codepkgs[owner[path]] = 1; continue }
        data++
      }
      names = ""
      for (p in codepkgs) names = names (names == "" ? "" : " ") p
      printf "%d %d %d %d %d %s", code+0, data+0, conf+0, drift+0, unreadable+0, names
    }' <<<"$out")

  state_set lastFileCheckUnix "$NOW"
  state_set fileResult "$(jq -Rn --arg s "$result" '$s')"
  report_files "$result" 0
}

# report_files <"code data conf drift unreadable pkg..."> <age-seconds>
report_files() {
  local packed="$1" age="${2:-0}" code data conf drift unreadable pkgs suffix="" note=""
  read -r code data conf drift unreadable pkgs <<<"$packed"
  code=${code:-0}; data=${data:-0}; conf=${conf:-0}; drift=${drift:-0}; unreadable=${unreadable:-0}
  [ "$age" -gt 3600 ] && suffix=" (checked $(( age / 3600 ))h ago)"

  [ "$data" -gt 0 ]  && note="${note}, $data data file(s)"
  [ "$conf" -gt 0 ]  && note="${note}, $conf config file(s)"
  [ "$drift" -gt 0 ] && note="${note}, $drift ownership/mode difference(s)"
  [ "$unreadable" -gt 0 ] && note="${note}, $unreadable unreadable"

  if [ "$code" -gt 0 ]; then
    add_check "int.files" "Packaged file integrity" "warn" \
      "$code executable file(s) differ from their package: ${pkgs}${note}${suffix}" \
      "pacman -Qkk ${pkgs%% *} to list them, then reinstall that package"
  else
    add_check "int.files" "Packaged file integrity" "ok" \
      "no packaged executable differs${note}${suffix}"
  fi
}

# ------------------------------------------------- boot and disk

check_secureboot() {
  if ! have bootctl; then
    add_check "int.secureboot" "Secure Boot" "unknown" "bootctl not available" ""
    return
  fi
  local line
  line=$(bootctl status 2>/dev/null | grep -i 'Secure Boot:' | head -1 | sed 's/.*Secure Boot: *//')
  case "$line" in
    enabled*) add_check "int.secureboot" "Secure Boot" "ok" "enabled" ;;
    "")       add_check "int.secureboot" "Secure Boot" "unknown" "not reported (BIOS boot?)" ;;
    *)        add_check "int.secureboot" "Secure Boot" "warn" "$line" \
                "enrol keys in firmware and sign the bootloader, or accept the risk" ;;
  esac
}

check_luks() {
  local src chain
  src=$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*\]//')
  if [ -z "$src" ]; then
    add_check "int.luks" "Root disk encryption" "unknown" "could not resolve the root device" ""
    return
  fi
  chain=$(lsblk -ns -o TYPE "$src" 2>/dev/null)
  if grep -q crypt <<<"$chain"; then
    add_check "int.luks" "Root disk encryption" "ok" "root is on a LUKS volume"
  else
    add_check "int.luks" "Root disk encryption" "warn" "root is not encrypted" \
      "encryption cannot be added in place; it is set at install time"
  fi
}

check_reboot() {
  local running moddir base
  running=$(uname -r)
  moddir="/usr/lib/modules/$running"
  if [ -d "$moddir" ]; then
    base=$(cat "$moddir/pkgbase" 2>/dev/null)
    add_check "int.reboot" "Running kernel" "ok" "$running (${base:-linux}) is the installed kernel"
  else
    add_check "int.reboot" "Running kernel" "warn" \
      "$running has been replaced on disk — a reboot is needed to run the patched kernel" \
      "omarchy system reboot"
  fi
}

check_foreign() {
  local n
  n=$(pacman -Qmq 2>/dev/null | wc -l)
  add_check "int.foreign" "Packages outside the repos" "info" \
    "$n AUR/foreign package(s) — these are not covered by Arch advisories" ""
}

# ------------------------------------------------- assemble

check_cve
check_files
check_secureboot
check_luks
check_reboot
check_foreign

CHECKS=$(printf '%s' "$CHECKS_JSON" | jq -sc '.')
WORST=ok; WORST_RANK=0
while IFS= read -r st; do
  [ -z "$st" ] && continue
  r=$(rank_of "$st")
  if [ "$r" -gt "$WORST_RANK" ]; then WORST_RANK=$r; WORST=$st; fi
done < <(jq -r '.[].status' <<<"$CHECKS")

SUMMARY="clean"
[ "${CVE_TOTAL:-0}" -gt 0 ] && SUMMARY="$CVE_TOTAL package(s) with advisories"

TMP=$(mktemp "$OUT_DIR/.integrity.XXXXXX")
jq -nc \
  --arg status "$WORST" --arg summary "$SUMMARY" --argjson checks "$CHECKS" \
  --arg generatedAt "$(date -Is)" --argjson generatedAtUnix "$NOW" \
  --argjson privileged "$( [ "$PRIVILEGED" = 1 ] && echo true || echo false )" \
  '{
     schemaVersion: 1,
     generatedAt: $generatedAt,
     generatedAtUnix: $generatedAtUnix,
     privileged: $privileged,
     sections: { integrity: { status:$status, summary:$summary, checks:$checks } }
   }' > "$TMP"

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
