#!/usr/bin/env bash
# Fast security collector for the Omarchy security widget.
#
# Runs as root on a short timer and writes a JSON snapshot that the
# unprivileged QML widget merely reads. Nothing in the UI ever needs a
# polkit prompt because nothing in the UI ever needs privilege.
#
# Never exits non-zero for a missing tool or an unreadable source: a check
# that could not run reports "unknown", which is deliberately not "ok".

set -uo pipefail

# Bumped together with the plugin manifest. The widget compares this
# against its own version so it can tell you when a plugin update has
# left a stale copy of this script installed under /usr/local/bin.
COLLECTOR_VERSION="1.0.0"

# Root writes where every session can read it; an ordinary user writes into
# their own runtime dir. The widget runs this itself when the system timer
# is not installed, so both paths are normal operation rather than fallback.
if [ "$(id -u)" -eq 0 ]; then
  PRIVILEGED=1
  DEFAULT_RUNTIME=/run/omarchy-security
  DEFAULT_STATE=/var/lib/omarchy-security
else
  PRIVILEGED=0
  DEFAULT_RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/omarchy-security"
  DEFAULT_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-security"
fi

OUT_DIR="${OMARCHY_SECURITY_RUNTIME:-$DEFAULT_RUNTIME}"
STATE_DIR="${OMARCHY_SECURITY_STATE:-$DEFAULT_STATE}"
OUT="$OUT_DIR/status.json"
GW_STATE="$STATE_DIR/gateways.json"

mkdir -p "$OUT_DIR" "$STATE_DIR" 2>/dev/null

# ---------------------------------------------------------------- helpers

# Rank used to roll a section up to its worst child. "info" is deliberately
# absent: informational rows carry detail, never severity, so an inventory
# count can never turn the bar icon amber.
rank_of() {
  case "$1" in
    fail) echo 3 ;;
    warn) echo 2 ;;
    unknown) echo 1 ;;
    *) echo 0 ;;
  esac
}

CHECKS_JSON=""
reset_checks() { CHECKS_JSON=""; }

# add_check <id> <label> <status> <detail> [remedy] [actions-json-array]
add_check() {
  local obj
  obj=$(jq -nc \
    --arg id "$1" --arg label "$2" --arg status "$3" \
    --arg detail "$4" --arg remedy "${5:-}" \
    --argjson actions "${6:-[]}" \
    '{id:$id,label:$label,status:$status,detail:$detail,remedy:$remedy,actions:$actions}')
  CHECKS_JSON="${CHECKS_JSON}${obj}"$'\n'
}

# An action the panel offers as a button. `kind` is "terminal" (runs in a
# terminal window, so sudo can prompt and output stays readable) or "url".
#
# Commands are composed here, in the collector, from a fixed vocabulary --
# never assembled in QML from panel state. Any package name interpolated into
# one goes through safe_names() first.
mkact() {
  jq -nc --arg label "$1" --arg kind "$2" --arg command "$3" \
    '{label:$label,kind:$kind,command:$command}'
}
acts() { [ "$#" -eq 0 ] && { echo '[]'; return; }; printf '%s\n' "$@" | jq -sc '.'; }

# pacman names are [A-Za-z0-9@._+-]; anything else did not come from pacman
# and has no business being pasted onto a command line.
safe_names() {
  tr ' ,' '\n\n' <<<"${1:-}" | grep -E '^[A-Za-z0-9@._+-]+$' | head -12 | tr '\n' ' ' | sed 's/ *$//'
}

# build_section <summary> [extra-json-object]
# Rolls the accumulated checks up to a worst-status and publishes the section
# in SECTION_OUT. It deliberately does not echo: the collect_* functions set
# shell globals that later stages depend on, and capturing them with $(...)
# would run them in a subshell and discard that state.
SECTION_OUT=""
build_section() {
  local summary="$1" extra="${2:-{\}}"
  local checks worst=ok worst_rank=0 st r
  checks=$(printf '%s' "$CHECKS_JSON" | jq -sc '.')
  while IFS= read -r st; do
    [ -z "$st" ] && continue
    r=$(rank_of "$st")
    if [ "$r" -gt "$worst_rank" ]; then worst_rank=$r; worst=$st; fi
  done < <(printf '%s' "$checks" | jq -r '.[].status')
  SECTION_OUT=$(jq -nc --arg status "$worst" --arg summary "$summary" \
    --argjson checks "$checks" --argjson extra "$extra" \
    '{status:$status,summary:$summary,checks:$checks} + $extra')
}

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- firewall

UFW_ENABLED=0
UFW_RUNNING=0
UFW_READABLE=0
UFW_DEFAULT_IN=""
UFW_RULE_COUNT=0
# Each entry: action|proto|loport|hiport|src|dst, in file order. ufw applies
# the first matching rule, so order is meaningful and must be preserved.
declare -a UFW_RULES=()

UFW_CONF=${OMARCHY_SECURITY_UFW_CONF:-/etc/ufw/ufw.conf}
UFW_DEFAULTS=${OMARCHY_SECURITY_UFW_DEFAULTS:-/etc/default/ufw}
UFW_RULES_V4=${OMARCHY_SECURITY_UFW_RULES:-/etc/ufw/user.rules}
UFW_RULES_V6=${OMARCHY_SECURITY_UFW_RULES6:-/etc/ufw/user6.rules}

# `ufw status` refuses to run as anyone but root, but every file it would
# read is world-readable, and the "### tuple ###" lines are a structured form
# of exactly the same ruleset — with application profiles already expanded
# into concrete ports, which the human-facing table leaves ambiguous.
parse_ufw_rules_file() {
  local file="$1" line rest action proto dport dst sport src dir
  local lo hi part
  [ -r "$file" ] || return 1

  while IFS= read -r line; do
    case "$line" in "### tuple ### "*) ;; *) continue ;; esac
    rest=${line#"### tuple ### "}
    rest=${rest% comment=*}
    read -r action proto dport dst sport src dir <<<"$rest"
    dir=${dir:-in}

    # Outbound and forwarding rules say nothing about what can reach us.
    [ "$dir" = "in" ] || continue
    case "$action" in
      allow|limit|deny|reject) ;;
      *) continue ;;
    esac

    UFW_RULE_COUNT=$((UFW_RULE_COUNT + 1))

    # ufw writes multiport rules as a comma-separated list.
    while IFS= read -r part; do
      [ -z "$part" ] && continue
      if [ "$part" = "any" ]; then
        lo=0; hi=65535
      elif [[ "$part" =~ ^([0-9]+):([0-9]+)$ ]]; then
        lo="${BASH_REMATCH[1]}"; hi="${BASH_REMATCH[2]}"
      elif [[ "$part" =~ ^[0-9]+$ ]]; then
        lo="$part"; hi="$part"
      else
        continue
      fi
      UFW_RULES+=("$action|$proto|$lo|$hi|$src|$dst")
    done < <(tr ',' '\n' <<<"$dport")
  done < "$file"
  return 0
}

collect_firewall() {
  reset_checks
  local v4_ok=1 v6_ok=1

  # Whether ufw is switched on, from its own config rather than its CLI.
  if [ -r "$UFW_CONF" ]; then
    grep -qiE '^ENABLED=(yes|true|1)' "$UFW_CONF" && UFW_ENABLED=1
  fi
  systemctl is-active --quiet ufw 2>/dev/null && UFW_RUNNING=1

  if [ -r "$UFW_DEFAULTS" ]; then
    UFW_DEFAULT_IN=$(sed -n 's/^DEFAULT_INPUT_POLICY="\?\([A-Za-z]*\)"\?.*/\1/p' "$UFW_DEFAULTS" | head -1)
    UFW_DEFAULT_IN=$(tr '[:upper:]' '[:lower:]' <<<"${UFW_DEFAULT_IN:-}")
  fi

  parse_ufw_rules_file "$UFW_RULES_V4" || v4_ok=0
  parse_ufw_rules_file "$UFW_RULES_V6" || v6_ok=0
  [ "$v4_ok" = 1 ] && UFW_READABLE=1

  if ! have ufw && [ "$UFW_READABLE" = 0 ]; then
    add_check "fw.active" "Firewall" "unknown" "ufw is not installed" "sudo pacman -S ufw"
    build_section "ufw not installed"
    return
  fi

  if [ "$UFW_ENABLED" = 1 ] && [ "$UFW_RUNNING" = 1 ]; then
    add_check "fw.active" "Firewall" "ok" "ufw is enabled and running"
  elif [ "$UFW_ENABLED" = 1 ]; then
    add_check "fw.active" "Firewall" "fail" \
      "ufw is configured on but its service is not running" "sudo systemctl start ufw" \
      "$(acts "$(mkact "Start ufw" terminal "sudo systemctl enable --now ufw")")"
  elif [ "$UFW_RUNNING" = 1 ]; then
    add_check "fw.active" "Firewall" "warn" \
      "the ufw service is running but its config says disabled" "sudo ufw enable" \
      "$(acts "$(mkact "Enable firewall" terminal "sudo ufw enable")")"
  else
    add_check "fw.active" "Firewall" "fail" "ufw is not enabled" "sudo ufw enable" \
      "$(acts "$(mkact "Enable firewall" terminal "sudo ufw enable")")"
  fi

  case "$UFW_DEFAULT_IN" in
    drop|reject)
      add_check "fw.default-incoming" "Default incoming policy" "ok" "$UFW_DEFAULT_IN" ;;
    accept)
      add_check "fw.default-incoming" "Default incoming policy" "fail" \
        "accept — every port is open unless a rule denies it" "sudo ufw default deny incoming" \
        "$(acts "$(mkact "Deny incoming" terminal "sudo ufw default deny incoming")")" ;;
    *)
      add_check "fw.default-incoming" "Default incoming policy" "unknown" \
        "could not read $UFW_DEFAULTS" "" ;;
  esac

  if [ "$UFW_READABLE" = 1 ]; then
    [ "$v6_ok" = 0 ] && add_check "fw.rules6" "IPv6 rules" "unknown" \
      "could not read $UFW_RULES_V6" ""
  else
    add_check "fw.rules" "Inbound rules" "unknown" \
      "could not read $UFW_RULES_V4 — exposure cannot be correlated" ""
  fi

  local summary
  if [ "$UFW_ENABLED" = 1 ] && [ "$UFW_RUNNING" = 1 ]; then
    summary="on · ${UFW_DEFAULT_IN:-?} incoming · $UFW_RULE_COUNT rules"
  else
    summary="off"
  fi
  build_section "$summary"
}

# Would ufw let an inbound packet reach <port>/<proto> on <listen-address>?
# Publishes UFW_VERDICT (allowed|blocked|unknown) and UFW_MATCH_FROM.
# Globals rather than stdout: a command substitution would run this in a
# subshell and discard the parsed ruleset.
UFW_MATCH_FROM=""
UFW_VERDICT="unknown"
ufw_verdict() {
  local port="$1" proto="$2" laddr="$3"
  local r action rproto lo hi src dst
  UFW_MATCH_FROM=""

  [ "$UFW_READABLE" = 1 ] || { UFW_VERDICT=unknown; return; }
  if [ "$UFW_ENABLED" != 1 ] || [ "$UFW_RUNNING" != 1 ]; then
    UFW_VERDICT=allowed; UFW_MATCH_FROM="firewall is off"; return
  fi

  for r in ${UFW_RULES+"${UFW_RULES[@]}"}; do
    IFS='|' read -r action rproto lo hi src dst <<<"$r"

    [ "$rproto" = "any" ] || [ "$rproto" = "$proto" ] || continue
    [ "$port" -ge "$lo" ] && [ "$port" -le "$hi" ] || continue

    # A rule scoped to one destination address only covers a listener that
    # actually answers on it — which a wildcard listener does.
    case "$dst" in
      0.0.0.0/0|::/0|any) ;;
      *)
        [ "$laddr" = "0.0.0.0" ] || [ "$laddr" = "::" ] || [ "$laddr" = "$dst" ] || continue ;;
    esac

    # First match wins, exactly as ufw applies them.
    case "$action" in
      allow|limit)
        UFW_VERDICT=allowed
        UFW_MATCH_FROM="$src"
        case "$dst" in 0.0.0.0/0|::/0|any) ;; *) UFW_MATCH_FROM="$src on $dst" ;; esac
        return ;;
      deny|reject)
        UFW_VERDICT=blocked; return ;;
    esac
  done

  case "$UFW_DEFAULT_IN" in
    drop|reject) UFW_VERDICT=blocked ;;
    accept) UFW_VERDICT=allowed; UFW_MATCH_FROM="default policy" ;;
    *) UFW_VERDICT=unknown ;;
  esac
}

# ---------------------------------------------------------------- exposure

# Addresses belonging to container / virtual bridges, so a docker DNS
# listener is not reported as a machine-wide exposure.
bridge_addrs() {
  ip -j addr show 2>/dev/null | jq -r '
    .[] | select(.ifname | test("^(docker|br-|virbr|veth|podman|cni)")) |
    .addr_info[]? | .local' 2>/dev/null
}

# Every address currently configured on the box. A socket bound to an address
# that no longer exists (a docker bridge that went away with the daemon) is
# not reachable by anyone, and must not be correlated as though it were.
local_addrs() {
  ip -j addr show 2>/dev/null | jq -r '.[].addr_info[]? | .local' 2>/dev/null
}

collect_exposure() {
  reset_checks
  local bridges laddrs listeners_json="" exposed=0 open_blocked=0 unknown_n=0 orphan_n=0

  bridges=$(bridge_addrs | tr '\n' ' ')
  laddrs=$(local_addrs | tr '\n' ' ')

  local line netid local_field proc addr port scope verdict pname ppid detail
  while IFS=$'\t' read -r netid local_field proc; do
    [ -z "${local_field:-}" ] && continue
    port="${local_field##*:}"
    addr="${local_field%:*}"
    addr="${addr#[}"; addr="${addr%]}"; addr="${addr%%\%*}"
    [[ "$port" =~ ^[0-9]+$ ]] || continue

    pname=$(sed -n 's/.*users:((\"\([^"]*\)\".*/\1/p' <<<"${proc:-}")
    ppid=$(sed -n 's/.*pid=\([0-9]*\).*/\1/p' <<<"${proc:-}")

    case "$addr" in
      127.*|::1) scope="local" ;;
      0.0.0.0|::|"*") scope="all" ;;
      100.6[4-9].*|100.[7-9][0-9].*|100.1[0-1][0-9].*|100.12[0-7].*|fd7a:115c:a1e0*) scope="tailnet" ;;
      22[4-9].*|23[0-9].*|ff0*) scope="multicast" ;;
      fe80*) scope="linklocal" ;;
      *) scope="specific" ;;
    esac

    if [ "$scope" = "specific" ]; then
      if [[ " $bridges " == *" $addr "* ]]; then
        scope="container"
      elif [[ " $laddrs " != *" $addr "* ]]; then
        # Bound to an address this machine no longer has.
        scope="orphan"
        orphan_n=$((orphan_n + 1))
      fi
    fi

    case "$scope" in
      all|specific) ufw_verdict "$port" "$netid" "$addr"; verdict="$UFW_VERDICT" ;;
      *) verdict="n/a"; UFW_MATCH_FROM="" ;;
    esac

    case "$verdict" in
      allowed) exposed=$((exposed + 1)) ;;
      blocked) open_blocked=$((open_blocked + 1)) ;;
      unknown) unknown_n=$((unknown_n + 1)) ;;
    esac

    listeners_json="${listeners_json}$(jq -nc \
      --arg proto "$netid" --arg addr "$addr" --argjson port "$port" \
      --arg scope "$scope" --arg verdict "$verdict" \
      --arg process "${pname:-}" --arg pid "${ppid:-}" \
      --arg from "${UFW_MATCH_FROM:-}" \
      '{proto:$proto,address:$addr,port:$port,scope:$scope,verdict:$verdict,process:$process,pid:$pid,allowedFrom:$from}')"$'\n'
  done < <(ss -tulnpH 2>/dev/null | awk '{p=""; for(i=7;i<=NF;i++) p=p $i; print $1"\t"$5"\t"p}')

  local listeners
  listeners=$(printf '%s' "$listeners_json" | jq -sc 'unique_by([.proto,.address,.port,.process])')
  local total
  total=$(jq -r 'length' <<<"$listeners")

  if [ "$exposed" -gt 0 ]; then
    # A v4 and a v6 socket on the same port are one finding, not two, and an
    # unnamed process still needs a readable slot in the sentence.
    detail=$(jq -r '[.[] | select(.verdict=="allowed") |
      ((if (.process // "") == "" then "unnamed process" else .process end)
       + " on " + .proto + "/" + (.port|tostring))] | unique | join(", ")' <<<"$listeners")
    add_check "exp.reachable" "Reachable from the network" "fail" \
      "$exposed listener(s): $detail" "close the port or drop the ufw allow rule" \
      "$(acts "$(mkact "Show ufw rules" terminal "sudo ufw status numbered")" \
              "$(mkact "Show listeners" terminal "sudo ss -tulnp")")"
  elif [ "$unknown_n" -gt 0 ]; then
    add_check "exp.reachable" "Reachable from the network" "unknown" \
      "no listener is known to be reachable, but $unknown_n could not be checked" ""
  else
    add_check "exp.reachable" "Reachable from the network" "ok" "nothing inbound is permitted"
  fi

  if [ "$unknown_n" -gt 0 ]; then
    add_check "exp.uncorrelated" "Listeners with an unresolved rule" "unknown" \
      "$unknown_n listener(s) could not be matched against ufw rules" ""
  fi
  if [ "$orphan_n" -gt 0 ]; then
    add_check "exp.orphan" "Bound to a vanished interface" "info" \
      "$orphan_n listener(s) — the address is gone, so nothing can reach them" ""
  fi

  if [ "$PRIVILEGED" != 1 ]; then
    local named unnamed
    named=$(jq -r '[.[] | select((.process // "") != "")] | length' <<<"$listeners")
    unnamed=$(( total - named ))
    if [ "$unnamed" -gt 0 ]; then
      add_check "exp.attribution" "Process attribution" "info" \
        "$unnamed socket(s) belong to other users and cannot be named without root" \
        "enable full checks to name every listening process"
    fi
  fi

  # sshd is the exposure everyone forgets about, so it gets its own row.
  local ssh_state
  ssh_state=$(systemctl is-enabled sshd 2>/dev/null)
  if [ "$ssh_state" = "enabled" ]; then
    if systemctl is-active --quiet sshd 2>/dev/null; then
      add_check "exp.sshd" "SSH server" "warn" "sshd is enabled and running" \
        "omarchy remove security sshd (if you do not need it)" \
        "$(acts "$(mkact "Disable SSH server" terminal "omarchy remove security sshd")" \
                "$(mkact "Show SSH config" terminal "sudo sshd -T | less")")"
    else
      add_check "exp.sshd" "SSH server" "warn" "sshd is enabled but not running" ""
    fi
  else
    add_check "exp.sshd" "SSH server" "ok" "disabled"
  fi

  local summary
  if [ "$exposed" -gt 0 ]; then summary="$exposed reachable · $total listening"
  elif [ "$unknown_n" -gt 0 ]; then summary="$unknown_n unresolved · $total listening"
  else summary="none reachable · $total listening"; fi
  build_section "$summary" "$(jq -nc --argjson l "$listeners" '{listeners:$l}')"
}

# ---------------------------------------------------------------- network

collect_network() {
  reset_checks
  local route gw dev contype ssid security dns dot

  route=$(ip -j route show default 2>/dev/null | jq -c '.[0] // {}')
  gw=$(jq -r '.gateway // ""' <<<"$route")
  dev=$(jq -r '.dev // ""' <<<"$route")

  if [ -z "$dev" ]; then
    add_check "net.route" "Default route" "warn" "no default route — this machine is offline" ""
  else
    contype=$(nmcli -t -f DEVICE,TYPE con show --active 2>/dev/null | awk -F: -v d="$dev" '$1==d{print $2}' | head -1)
    add_check "net.route" "Default route" "info" "${dev} via ${gw:-unknown} (${contype:-unknown})" ""
  fi

  # Wi-Fi encryption. An open network is the single highest-value warning
  # this widget can produce, so it is a fail rather than a warn.
  if [ "${contype:-}" = "802-11-wireless" ] || [ "${contype:-}" = "wifi" ]; then
    local wifi
    wifi=$(nmcli -t -f ACTIVE,SSID,SECURITY dev wifi 2>/dev/null | grep '^yes:' | head -1)
    ssid=$(cut -d: -f2 <<<"$wifi")
    security=$(cut -d: -f3- <<<"$wifi")
    if [ -z "$security" ] || [ "$security" = "--" ]; then
      add_check "net.wifi" "Wi-Fi encryption" "fail" "\"$ssid\" is an open network — traffic is unencrypted" \
        "use a VPN or tailscale on this network"
    elif [[ "$security" == *WEP* ]]; then
      add_check "net.wifi" "Wi-Fi encryption" "fail" "\"$ssid\" uses WEP, which is broken" ""
    else
      add_check "net.wifi" "Wi-Fi encryption" "ok" "\"$ssid\" — $security"
    fi
  fi
  # No row at all when there is no Wi-Fi: an inapplicable check is noise, not
  # reassurance.

  # DNS resolvers and transport.
  if have resolvectl; then
    local status
    status=$(resolvectl status 2>/dev/null)
    dns=$(grep -m1 'Current DNS Server:' <<<"$status" | sed 's/.*Current DNS Server: *//')
    if grep -q '+DNSOverTLS' <<<"$status"; then dot="on"; else dot="off"; fi
    add_check "net.dns" "DNS resolver" "info" "${dns:-unknown}" ""
    if [ "$dot" = "on" ]; then
      add_check "net.dot" "DNS over TLS" "ok" "on"
    else
      add_check "net.dot" "DNS over TLS" "info" "off — DNS queries are sent in the clear" \
        "set DNSOverTLS=yes in /etc/systemd/resolved.conf" \
        "$(acts "$(mkact "Edit resolved.conf" terminal "sudoedit /etc/systemd/resolved.conf")")"
    fi
  else
    add_check "net.dns" "DNS resolver" "unknown" "systemd-resolved not available" ""
  fi

  # Gateway MAC. A changed MAC for a gateway we have seen before on the same
  # connection is the cheap local signal for ARP spoofing or a swapped router.
  if [ -n "$gw" ] && [ -n "$dev" ]; then
    local mac key prev
    mac=$(ip neigh show "$gw" dev "$dev" 2>/dev/null | sed -n 's/.*lladdr \([0-9a-f:]*\).*/\1/p' | head -1)
    key="${dev}|${gw}"
    if [ -z "$mac" ]; then
      add_check "net.gateway" "Gateway identity" "unknown" "no ARP entry for $gw yet" ""
    else
      [ -f "$GW_STATE" ] || echo '{}' > "$GW_STATE"
      prev=$(jq -r --arg k "$key" '.[$k] // ""' "$GW_STATE" 2>/dev/null)
      if [ -z "$prev" ]; then
        add_check "net.gateway" "Gateway identity" "ok" "$mac (first seen, now remembered)"
        jq -c --arg k "$key" --arg v "$mac" '.[$k]=$v' "$GW_STATE" > "$GW_STATE.tmp" 2>/dev/null \
          && mv "$GW_STATE.tmp" "$GW_STATE"
      elif [ "$prev" != "$mac" ]; then
        add_check "net.gateway" "Gateway identity" "fail" \
          "gateway MAC changed: $prev -> $mac" \
          "expected after a router swap; otherwise treat this network as hostile" \
          "$(acts "$(mkact "Accept new gateway" terminal "sudo rm -f $GW_STATE && echo 'Gateway record cleared; it will be re-learned.'")" \
                  "$(mkact "Show ARP table" terminal "ip neigh show")")"
      else
        add_check "net.gateway" "Gateway identity" "ok" "$mac (unchanged)"
      fi
    fi
  fi

  build_section "${dev:-offline}${dns:+ · $dns}"
}

# ---------------------------------------------------------------- assemble

collect_firewall; FIREWALL="$SECTION_OUT"
collect_exposure; EXPOSURE="$SECTION_OUT"
collect_network;  NETWORK="$SECTION_OUT"

TMP=$(mktemp "$OUT_DIR/.status.XXXXXX")
jq -nc \
  --argjson firewall "$FIREWALL" \
  --argjson exposure "$EXPOSURE" \
  --argjson network "$NETWORK" \
  --arg generatedAt "$(date -Is)" \
  --argjson generatedAtUnix "$(date +%s)" \
  --argjson privileged "$( [ "$PRIVILEGED" = 1 ] && echo true || echo false )" \
  --arg collectorVersion "$COLLECTOR_VERSION" \
  '{
     schemaVersion: 1,
     collectorVersion: $collectorVersion,
     generatedAt: $generatedAt,
     generatedAtUnix: $generatedAtUnix,
     privileged: $privileged,
     sections: { firewall: $firewall, exposure: $exposure, network: $network }
   }' > "$TMP"

chmod 0644 "$TMP"
mv "$TMP" "$OUT"
